{
  "name": "car-booking-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Modular REST API for car bookings and delivery services",
  "type": "module",
  "scripts": {
    "dev": "npm run frontend:build --silent && npm run build --silent && node dist/server.js",
    "frontend:dev": "npm --prefix CarBooking-Frontend/carbooking-frontend run dev",
    "frontend:build": "npm --prefix CarBooking-Frontend/carbooking-frontend run build",
    "build": "tsc -p tsconfig.json",
    "start": "npm run frontend:build --silent && npm run build --silent && node dist/server.js",
    "remote:enable": "node scripts/enable-tailnet.mjs",
    "cli": "npm run build --silent && node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/api.test.js",
    "db:reset": "npm run build --silent && node dist/database/reset.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.1",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2"
  }
}
